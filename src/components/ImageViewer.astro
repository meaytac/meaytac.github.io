<dialog id="image-viewer" class="image-viewer" aria-label="Image preview">
  <form method="dialog">
    <button class="image-viewer-close" aria-label="Close image preview" autofocus>
      <span aria-hidden="true">×</span>
    </button>
  </form>
  <img alt="" />
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('#image-viewer');
  const image = viewer?.querySelector('img');

  if (viewer && image && typeof viewer.showModal === 'function') {
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-image-viewer]');
      const thumbnail = link?.querySelector('img');
      if (!link || !thumbnail) return;

      event.preventDefault();
      image.src = link.href;
      image.alt = thumbnail.alt;
      viewer.showModal();
    });

    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>
