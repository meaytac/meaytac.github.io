---
import type { Project } from '../content/portfolio';
import ProjectLinks from './ProjectLinks.astro';
import HousingScreenshots from './HousingScreenshots.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="project-card featured">
  <div class="project-copy">
    <p class="project-context">{project.context}</p>
    <h3>{project.title}</h3>
    <p class="project-summary">{project.summary}</p>
    <ProjectLinks project={project} showStudy />
  </div>
  <HousingScreenshots compact />
  <ul class="tags project-technologies" aria-label="Technologies used">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>
